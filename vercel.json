{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": [
          "dist/**",
          "node_modules/@sparticuz/chromium/**",
          "node_modules/swagger-ui-dist/**",
          "node_modules/@nestjs/swagger/node_modules/swagger-ui-dist/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}
