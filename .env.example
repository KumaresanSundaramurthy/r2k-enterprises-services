PORT=5000
JWT_KEY=change_this_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# MySQL (product catalog)
READ_DB_HOSTNAME=localhost
WRITE_DB_HOSTNAME=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_this_password
MYSQL_DATABASE=Products
# Max connections per pool — keep low (e.g. 2) on Vercel, where every function instance has its own pools
DB_POOL_MAX=10
DEFAULT_ORG_UID=1
# Base URL to prefix onto EntityAttachmentsTbl.FilePath to form a full image URL
ASSET_BASE_URL=http://localhost:5000

# ── ERP login (shared with the CI3 app — use the SAME values as its .env) ──────
JWT_COOKIE_NAME=r2k_token
LOGIN_EXPIRE_SECS=7200
# production → Redis keys prefixed P-, anything else → S- (must match CI3's CI_ENV)
CI_ENV=development
HTTP_HOST=localhost
# Web app base URL — used for links in emails and redirects after Google/Facebook sign-in
APP_BASE_URL=http://localhost/r2k
# Public URL of this API — used for OAuth callback URLs registered with Google/Facebook
API_BASE_URL=http://localhost:5000
# Parent domain both apps share (e.g. .rishika2kenterprises.com) so the session cookie is visible to both
COOKIE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1

# Redis (sessions) — same instance as CI3. REDIS_PROTOCOL=tls for TLS connections
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
# Upstash REST store CI3 uses for browser-readable flags (has-price-lists)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Brevo)
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@rishika2kenterprises.com
MAIL_FROM_NAME=Rishika 2K Enterprises

# Social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Onboarding GSTIN verification and CDN for user images
GSTIN_API_KEY=
FILE_UPLOAD=cloudflare
CDN_URL=
CFLARE_R2_CDN=
